@model HealthTrack.Models.Admin.EditTrainerViewModel
@{ ViewData["Title"] = "Edit User"; }
<section class="dashboard-heading"><h1>Edit User</h1><p class="mb-0">Update profile information and account access. Existing roles are preserved.</p></section>
<div class="card dashboard-card"><div class="card-body">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="TargetWeight" class="form-label"></label><input asp-for="TargetWeight" class="form-control" type="number" min="1" max="500" step="0.01" /><span asp-validation-for="TargetWeight" class="text-danger"></span></div>
        <div class="col-md-6"><div class="form-check mt-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active account</label></div><span asp-validation-for="IsActive" class="text-danger"></span></div>
    </div>
    <div class="quick-actions mt-4"><button type="submit" class="btn btn-success">Save changes</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div>
</form>
</div></div>
