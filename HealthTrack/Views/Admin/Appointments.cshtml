@model List<Appointment>
@{ ViewData["Title"] = "Appointments"; }
<section class="dashboard-heading mb-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1>Appointments</h1>
            <p class="mb-0">All appointments across trainers and healthcare professionals. Read-only access.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="TrainerAvailability" asp-action="Index" class="btn btn-outline-success">
                <i class="bi bi-calendar3-range me-1"></i> Trainer Schedules
            </a>
            <a asp-controller="TrainerAvailability" asp-action="Leave" class="btn btn-outline-danger">
                <i class="bi bi-airplane me-1"></i> Trainer Leaves
            </a>
        </div>
    </div>
</section>
<p class="text-muted">Dates and times use @ViewData["TimeZoneId"].</p>
@if (Model.Count == 0)
{
    <div class="alert alert-info">No appointments yet.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th scope="col">Client</th><th scope="col">Provider</th><th scope="col">Date</th><th scope="col">Time</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
            @foreach (var appointment in Model)
            {
                <tr><td>@appointment.Client.FullName</td><td>@appointment.ProviderName</td><td>@appointment.AppointmentDate.ToString("yyyy-MM-dd")</td><td>@appointment.AppointmentTime.ToString("HH:mm")</td><td><partial name="_AppointmentStatus" model="appointment.Status" /></td><td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-sm btn-outline-success">Details</a></td></tr>
            }
            </tbody>
        </table>
    </div></div>
}
