@model HealthTrack.Models.Admin.AdminUserListItem
@{ ViewData["Title"] = "User Details"; }
<section class="dashboard-heading"><h1>User Details</h1><p class="mb-0">@Model.FullName</p></section>
<div class="card dashboard-card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9 text-break">@Model.Email</dd>
        <dt class="col-sm-3">Roles</dt><dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @(Model.IsActive ? "status-positive" : "status-muted")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
        <dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Target weight</dt><dd class="col-sm-9">@(Model.TargetWeight is { } weight ? weight.ToString("0.##") + " kg" : "Not set")</dd>
    </dl>
    <div class="quick-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">Edit user</a>
        @if (ViewData["CanRemove"] is true) { <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">@(ViewData["HasHistory"] is true ? "Deactivate" : "Delete")</a> }
        <a asp-action="Users" class="btn btn-outline-secondary">Back to users</a>
    </div>
</div></div>
