@model List<ApplicationUser>
@{ ViewData["Title"] = "Assigned Clients"; }
<section class="dashboard-heading"><h1>Assigned Clients</h1><p>Create plans and review workout logs for your clients.</p></section>
@if (Model.Count == 0)
{
    <div class="alert alert-info">No active clients are currently assigned to you.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Name</th><th>Email</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var client in Model)
        {
            <tr><td>@client.FullName</td><td>@client.Email</td><td>
                <a asp-controller="TrainerWorkouts" asp-action="Create" asp-route-clientId="@client.Id" class="btn btn-sm btn-outline-primary">Create workout plan</a>
                <a asp-controller="TrainerDiets" asp-action="Create" asp-route-clientId="@client.Id" class="btn btn-sm btn-outline-primary">Create diet plan</a>
                <a asp-controller="TrainerWorkouts" asp-action="Logs" asp-route-clientId="@client.Id" class="btn btn-sm btn-outline-secondary">Workout logs</a>
            </td></tr>
        }
        </tbody>
    </table></div></div>
}
