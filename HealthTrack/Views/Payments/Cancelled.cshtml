@{
    ViewData["Title"] = "Payment Cancelled";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 text-center">
        <div class="card dashboard-card shadow-sm border-0 p-4">
            <div class="card-body">
                <div class="fs-1 text-secondary mb-3">✕</div>
                <h1 class="h3 fw-bold mb-2">Payment Cancelled</h1>
                <p class="text-muted mb-4">
                    The payment session was cancelled. No charges were made to your account, and your subscription has not been modified.
                </p>

                @if (ViewBag.OrderId != null)
                {
                    <div class="p-3 bg-light rounded text-muted small mb-4">
                        Cancelled Order Reference: <strong>@ViewBag.OrderId</strong>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="MembershipPackages" asp-action="Index" class="btn btn-success">
                        Browse Packages Again
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
                        Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
