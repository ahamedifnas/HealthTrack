@model HealthTrack.Models.Payments.CheckoutSummaryViewModel
@{
    ViewData["Title"] = "Checkout - " + Model.PackageName;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card dashboard-card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                    <div>
                        <span class="badge bg-success mb-1">Secure Checkout</span>
                        <h1 class="h3 mb-0">Order Summary</h1>
                    </div>
                    <span class="fs-1 text-success">💳</span>
                </div>

                <div class="mb-4">
                    <h2 class="h5 fw-bold mb-1">@Model.PackageName</h2>
                    <p class="text-muted small mb-3">@Model.Description</p>

                    <div class="p-3 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Package Duration</span>
                            <span class="fw-semibold">@Model.DurationDays Days</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subscriber</span>
                            <span class="fw-semibold">@Model.ClientName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Account Email</span>
                            <span class="fw-semibold">@Model.ClientEmail</span>
                        </div>
                        @if (Model.IsRenewal)
                        {
                            <div class="d-flex justify-content-between mb-2 text-primary">
                                <span>Membership Type</span>
                                <span class="fw-semibold">Renewal / Extension</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between text-muted small border-top pt-2">
                            <span>Projected Coverage</span>
                            <span>@Model.ProjectedStartDate.ToString("dd MMM yyyy") – @Model.ProjectedEndDate.ToString("dd MMM yyyy")</span>
                        </div>
                    </div>

                    @if (Model.Benefits.Count > 0)
                    {
                        <div class="mb-3">
                            <h3 class="h6 fw-bold mb-2">Package Highlights</h3>
                            <ul class="list-unstyled mb-0">
                                @foreach (var benefit in Model.Benefits)
                                {
                                    <li class="small mb-1"><span class="text-success fw-bold me-2">✓</span>@benefit</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center border-top pt-3 mb-4">
                        <div>
                            <span class="d-block text-muted small">Total Payable (LKR)</span>
                            <strong class="fs-3 text-success">LKR @Model.PriceLKR.ToString("N2")</strong>
                        </div>
                        <span class="badge bg-light text-dark border">@(Model.IsDemo ? "DEMO PAYMENT – NO REAL MONEY" : "PayHere Sandbox")</span>
                    </div>

                    <div class="alert alert-info small mb-4">
                        @(Model.IsDemo ? "Simulate a payment locally. No real money will be collected." : "You will be transferred to PayHere Sandbox to complete this transaction.")</div>

                    <form asp-action="Initiate" method="post">
                        <input type="hidden" name="packageId" value="@Model.PackageId" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg py-3 fw-bold">
                                Proceed to Pay LKR @Model.PriceLKR.ToString("N0") →
                            </button>
                            <a asp-controller="MembershipPackages" asp-action="Index" class="btn btn-outline-secondary">
                                Cancel & Return to Packages
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
