@model WorkoutLogForm
@{ var editing = ViewData["IsEditing"] is true; ViewData["Title"] = editing ? "Edit Workout Log" : "Log Workout"; }
<h1>@ViewData["Title"]</h1>
@if (Model.Plans.Count == 0)
{
    <div class="alert alert-info">You need an active workout plan before you can add a log.</div>
}
else
{
    <p class="text-muted">@(editing ? "Correct your recorded workout. The original plan is preserved." : "Record a completed workout. Choose a plan and click Load exercises before filling in the workout fields.") The date must be within the plan dates and cannot be in the future.</p>
    @if (!editing) {
<form asp-action="Log" method="get" class="mb-3">
        <label for="planId" class="form-label">Choose workout plan</label>
        <select id="planId" name="planId" class="form-select" asp-items="Model.Plans"></select>
        <button type="submit" class="btn btn-outline-primary mt-2">Load exercises</button>
    </form>
    }
    <div class="card dashboard-card"><div class="card-body">
    <form asp-action="@(editing ? "EditLog" : "Log")" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="row"><div class="col-12 col-md-6 mb-3">
    <label asp-for="WorkoutPlanId" class="form-label"></label>
    <input asp-for="WorkoutPlanId" type="hidden" /><p class="form-control-plaintext">@Model.SelectedPlanName</p>
    <span asp-validation-for="WorkoutPlanId" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="WorkoutExerciseId" class="form-label"></label>
    <select asp-for="WorkoutExerciseId" class="form-select" asp-items="Model.Exercises"><option value="">Whole workout / no specific exercise</option></select>
    <span asp-validation-for="WorkoutExerciseId" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="WorkoutDate" class="form-label"></label>
    <input asp-for="WorkoutDate" class="form-control" >
    <span asp-validation-for="WorkoutDate" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="DurationMinutes" class="form-label"></label>
    <input asp-for="DurationMinutes" class="form-control" >
    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="CaloriesBurned" class="form-label"></label>
    <input asp-for="CaloriesBurned" class="form-control" >
    <span asp-validation-for="CaloriesBurned" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="Notes" class="form-label"></label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div></div>
        @if (editing) { <div class="form-check mb-3"><input asp-for="Completed" class="form-check-input" /><label asp-for="Completed" class="form-check-label">Completed workout</label></div> }
<button class="btn btn-primary" type="submit">@(editing ? "Save changes" : "Save completed workout")</button>
        <a asp-action="History" class="btn btn-outline-secondary">View history</a>
    </form>
    </div></div>
}

