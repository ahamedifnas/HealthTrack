@model IReadOnlyList<HealthTrack.Models.Notification>
@{ ViewData["Title"] = "Notifications"; }
<h1>Notifications</h1>
<p class="text-muted">Your appointment and plan updates. Times below are UTC.</p>
@if (Model.Count == 0)
{
    <div class="alert alert-info">No notifications yet.</div>
}
@foreach (var notification in Model)
{
    <article class="card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <h2 class="h5">@notification.Title</h2>
                @if (notification.IsRead) { <span class="badge bg-secondary">Read</span> }
                else { <span class="badge bg-success">Unread</span> }
            </div>
            <p class="text-break">@notification.Message</p>
            <p class="small text-muted">@notification.Type · @notification.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p>
            @if (!notification.IsRead)
            {
                <form asp-action="MarkRead" asp-route-id="@notification.Id" method="post">
                    <button class="btn btn-outline-success btn-sm" type="submit">Mark as read</button>
                </form>
            }
        </div>
    </article>
}
