@model List<HealthTrack.Models.Appointments.TrainerUnavailability>
@{
    ViewData["Title"] = ViewBag.IsAdmin == true ? $"Trainer Time Off & Leave - {ViewBag.TrainerName}" : "My Time Off & Leave";
}

<section class="dashboard-heading mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1"><i class="bi bi-airplane text-danger me-2"></i>@(ViewBag.IsAdmin == true ? $"Trainer Leave: {ViewBag.TrainerName}" : "My Time Off & Leave")</h1>
            <p class="text-muted mb-0">Manage leave periods, holidays, and temporary unavailability. Unavailability windows are automatically excluded from client booking slots.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateLeave" asp-route-trainerId="@ViewBag.TrainerId" class="btn btn-danger">
                <i class="bi bi-plus-circle me-1"></i> Add Time Off
            </a>
            <a asp-action="Index" asp-route-trainerId="@ViewBag.TrainerId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Schedule
            </a>
        </div>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.IsAdmin == true && ViewBag.Trainers != null && ((List<SelectListItem>)ViewBag.Trainers).Count > 0)
{
    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body py-2 px-3">
            <form method="get" asp-action="Leave" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold small text-muted"><i class="bi bi-person-badge me-1"></i> Select Trainer:</label>
                </div>
                <div class="col-auto">
                    <select name="trainerId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var item in (List<SelectListItem>)ViewBag.Trainers)
                        {
                            <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
}

<div class="card dashboard-card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-check display-4 text-muted mb-3 d-block"></i>
                <h6 class="fw-semibold">No leave or time off records</h6>
                <p class="text-muted small mb-3">All scheduled working hours are currently open for appointments.</p>
                <a asp-action="CreateLeave" asp-route-trainerId="@ViewBag.TrainerId" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-plus me-1"></i> Add Leave Period
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Period</th>
                            <th>Time / Type</th>
                            <th>Reason / Description</th>
                            <th>Status</th>
                            <th>Registered</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model)
                        {
                            <tr class="@(leave.Status == HealthTrack.Models.Appointments.TrainerLeaveStatus.Cancelled ? "opacity-50" : "")">
                                <td>
                                    <strong>@leave.StartDate.ToString("MMM dd, yyyy")</strong>
                                    @if (leave.EndDate != leave.StartDate)
                                    {
                                        <span> &rarr; <strong>@leave.EndDate.ToString("MMM dd, yyyy")</strong></span>
                                    }
                                </td>
                                <td>
                                    @if (leave.IsFullDay)
                                    {
                                        <span class="badge bg-secondary">Full Day</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @leave.StartTime?.ToString("hh:mm tt") - @leave.EndTime?.ToString("hh:mm tt")
                                        </span>
                                    }
                                </td>
                                <td>@leave.Reason</td>
                                <td>
                                    @if (leave.Status == HealthTrack.Models.Appointments.TrainerLeaveStatus.Active)
                                    {
                                        <span class="badge bg-danger">Active Leave</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelled / Revoked</span>
                                    }
                                </td>
                                <td class="small text-muted">@leave.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    @if (leave.Status == HealthTrack.Models.Appointments.TrainerLeaveStatus.Active)
                                    {
                                        <form asp-action="CancelLeave" asp-route-id="@leave.Id" method="post" class="d-inline" onsubmit="return confirm('Revoke this leave period? Blocked slots will become bookable again.');">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cancel/Revoke Leave">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Revoke
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
