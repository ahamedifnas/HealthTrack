@model HealthTrack.Models.Appointments.TrainerAvailabilityForm
@{
    ViewData["Title"] = "Add Working Hours Schedule";
}

<section class="dashboard-heading mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1"><i class="bi bi-clock text-success me-2"></i>Add Working Hours Schedule</h1>
            <p class="text-muted mb-0">Define recurring weekly available hours and break periods for client bookings.</p>
        </div>
        <a asp-action="Index" asp-route-trainerId="@Model.TrainerId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Schedule
        </a>
    </div>
</section>

<div class="card dashboard-card border-0 shadow-sm max-w-750">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" id="scheduleForm">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-4" role="alert"></div>
            }

            @if (Model.Trainers.Count > 0)
            {
                <div class="mb-3">
                    <label asp-for="TrainerId" class="form-label fw-bold">Trainer</label>
                    <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select"></select>
                    <span asp-validation-for="TrainerId" class="text-danger small"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="TrainerId" />
            }

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="DayOfWeek" class="form-label fw-bold">Day of the Week</label>
                    <select asp-for="DayOfWeek" class="form-select">
                        <option value="@DayOfWeek.Monday">Monday</option>
                        <option value="@DayOfWeek.Tuesday">Tuesday</option>
                        <option value="@DayOfWeek.Wednesday">Wednesday</option>
                        <option value="@DayOfWeek.Thursday">Thursday</option>
                        <option value="@DayOfWeek.Friday">Friday</option>
                        <option value="@DayOfWeek.Saturday">Saturday</option>
                        <option value="@DayOfWeek.Sunday">Sunday</option>
                    </select>
                    <span asp-validation-for="DayOfWeek" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="SlotDurationMinutes" class="form-label fw-bold">Slot Duration</label>
                    <select asp-for="SlotDurationMinutes" class="form-select">
                        <option value="30">30 Minutes</option>
                        <option value="45">45 Minutes</option>
                        <option value="60" selected>60 Minutes (1 Hour)</option>
                        <option value="90">90 Minutes</option>
                        <option value="120">120 Minutes (2 Hours)</option>
                    </select>
                    <span asp-validation-for="SlotDurationMinutes" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6">
                    <label asp-for="StartTime" class="form-label fw-bold">Work Start Time</label>
                    <input asp-for="StartTime" asp-format="{0:HH:mm}" class="form-control" type="time" value="09:00" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="EndTime" class="form-label fw-bold">Work End Time</label>
                    <input asp-for="EndTime" asp-format="{0:HH:mm}" class="form-control" type="time" value="17:00" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>
            </div>

            <!-- Optional Date Range -->
            <div class="card bg-light border-0 p-3 mb-4">
                <h6 class="fw-bold mb-2"><i class="bi bi-calendar-range me-1 text-primary"></i> Optional Effective Date Range</h6>
                <p class="text-muted small mb-3">Leave blank if this schedule is permanent and active indefinitely.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="EffectiveStartDate" class="form-label small fw-semibold">Effective Start Date</label>
                        <input asp-for="EffectiveStartDate" class="form-control" type="date" />
                        <span asp-validation-for="EffectiveStartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="EffectiveEndDate" class="form-label small fw-semibold">Effective End Date</label>
                        <input asp-for="EffectiveEndDate" class="form-control" type="date" />
                        <span asp-validation-for="EffectiveEndDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Breaks Section -->
            <div class="card bg-light border-0 p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-cup-hot me-1 text-warning"></i> Break Periods (Lunch / Rest)</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addBreakBtn">
                        <i class="bi bi-plus me-1"></i> Add Break
                    </button>
                </div>
                <div id="breaksContainer" class="d-flex flex-column gap-2">
                    <!-- Dynamic break rows -->
                </div>
                <div id="noBreaksText" class="text-muted small fst-italic">No breaks added yet. Click 'Add Break' to schedule lunch or rest periods.</div>
            </div>

            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="isActiveSwitch" checked>
                <label class="form-check-label fw-semibold" for="isActiveSwitch">Enable this schedule for client bookings</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Save Schedule
                </button>
                <a asp-action="Index" asp-route-trainerId="@Model.TrainerId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const breaksContainer = document.getElementById("breaksContainer");
    const noBreaksText = document.getElementById("noBreaksText");
    const addBreakBtn = document.getElementById("addBreakBtn");
    let breakIndex = 0;

    addBreakBtn.addEventListener("click", function () {
        addBreakRow("", "", "Lunch Break");
    });

    function addBreakRow(start, end, desc) {
        noBreaksText.style.display = "none";
        const row = document.createElement("div");
        row.className = "row g-2 align-items-center break-row bg-white p-2 rounded border";
        row.innerHTML = `
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold mb-1">Break Start</label>
                <input type="time" name="Breaks[${breakIndex}].BreakStartTime" class="form-control form-control-sm" value="${start || '12:00'}" required />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold mb-1">Break End</label>
                <input type="time" name="Breaks[${breakIndex}].BreakEndTime" class="form-control form-control-sm" value="${end || '13:00'}" required />
            </div>
            <div class="col-10 col-md-3">
                <label class="form-label small fw-semibold mb-1">Description</label>
                <input type="text" name="Breaks[${breakIndex}].Description" class="form-control form-control-sm" value="${desc || 'Lunch Break'}" maxlength="100" />
            </div>
            <div class="col-2 col-md-1 text-end pt-md-3">
                <button type="button" class="btn btn-sm btn-outline-danger remove-break-btn" title="Remove Break">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        `;

        row.querySelector(".remove-break-btn").addEventListener("click", function () {
            row.remove();
            if (breaksContainer.children.length === 0) {
                noBreaksText.style.display = "block";
            }
        });

        breaksContainer.appendChild(row);
        breakIndex++;
    }
});
</script>
}
