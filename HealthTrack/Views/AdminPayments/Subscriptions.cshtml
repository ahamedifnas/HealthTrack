@model HealthTrack.Models.Payments.AdminSubscriptionListViewModel
@{
    ViewData["Title"] = "Client Subscriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Client Memberships & Subscriptions</h1>
        <p class="text-muted mb-0">Manage gym memberships, oversee renewals, handle extensions, and track expirations.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RunExpirationCheck" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-warning" title="Run manual reconciliation for expired subscriptions and send alerts">
                ⚡ Run Expiration Check Now
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">← Payment Transactions</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Metrics Summary -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm text-center">
            <span class="text-muted small text-uppercase">Total Subscriptions</span>
            <div class="fs-4 fw-bold text-dark">@Model.TotalSubscriptions</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm text-center">
            <span class="text-muted small text-uppercase">Active Members</span>
            <div class="fs-4 fw-bold text-success">@Model.ActiveSubscriptions</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm text-center">
            <span class="text-muted small text-uppercase">Expiring in ≤ 3 Days</span>
            <div class="fs-4 fw-bold text-warning">@Model.ExpiringSoonCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm text-center">
            <span class="text-muted small text-uppercase">Expired / Renewed</span>
            <div class="fs-4 fw-bold text-secondary">@(Model.ExpiredSubscriptions + Model.RenewedSubscriptions)</div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card dashboard-card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold">Search Member</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Client name, email, package..." />
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Active" selected="@(Model.SelectedStatus == "Active")">Active</option>
                    <option value="Renewed" selected="@(Model.SelectedStatus == "Renewed")">Renewed</option>
                    <option value="Expired" selected="@(Model.SelectedStatus == "Expired")">Expired</option>
                    <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-success flex-grow-1">Filter</button>
                <a asp-action="Subscriptions" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Subscriptions.Count == 0)
{
    <div class="alert alert-info">No subscriptions match your search criteria.</div>
}
else
{
    <div class="card dashboard-card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Client</th>
                        <th scope="col">Tier Snapshot</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Status</th>
                        <th scope="col">Validity Period</th>
                        <th scope="col">Admin Notes</th>
                        <th scope="col" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.Subscriptions)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong>@sub.Client.FullName</strong>
                                <div class="small text-muted">@sub.Client.Email</div>
                            </td>
                            <td>
                                <div><strong>@sub.PackageNameSnapshot</strong></div>
                                <div class="small text-muted">@sub.DurationDaysSnapshot Days</div>
                            </td>
                            <td><strong class="text-success">LKR @sub.AmountPaidLKR.ToString("N2")</strong></td>
                            <td>
                                @switch (sub.Status)
                                {
                                    case HealthTrack.Models.Memberships.SubscriptionStatus.Active:
                                        <span class="badge bg-success">Active</span>
                                        break;
                                    case HealthTrack.Models.Memberships.SubscriptionStatus.Renewed:
                                        <span class="badge bg-info text-dark">Renewed</span>
                                        break;
                                    case HealthTrack.Models.Memberships.SubscriptionStatus.Expired:
                                        <span class="badge bg-secondary">Expired</span>
                                        break;
                                    case HealthTrack.Models.Memberships.SubscriptionStatus.Cancelled:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@sub.Status</span>
                                        break;
                                }
                            </td>
                            <td>
                                <div>@sub.StartDate.ToString("yyyy-MM-dd") to @sub.EndDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-muted">Activated: @sub.ActivatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(sub.AdminNotes))
                                {
                                    <span class="small text-info text-truncate d-inline-block" style="max-width: 180px;" title="@sub.AdminNotes">
                                        @sub.AdminNotes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="ManageSubscription" asp-route-id="@sub.Id" class="btn btn-outline-primary" title="Extend or manage subscription">
                                        Manage
                                    </a>
                                    @if (sub.PaymentTransaction != null)
                                    {
                                        <a asp-controller="Payments" asp-action="Receipt" asp-route-orderId="@sub.PaymentTransaction.OrderId" class="btn btn-outline-secondary" title="View receipt">
                                            Receipt
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
