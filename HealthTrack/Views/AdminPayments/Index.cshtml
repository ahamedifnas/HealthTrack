@model HealthTrack.Models.Payments.AdminPaymentListViewModel
@{
    ViewData["Title"] = "Payment Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Payment & Revenue Management</h1>
        <p class="text-muted mb-0">Monitor verified PayHere transactions, client orders, and subscription activations.</p>
    </div>
    <a asp-action="Subscriptions" class="btn btn-outline-success">View All Subscriptions →</a>
</div>

<!-- Financial Summary Widgets -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm">
            <span class="text-muted small text-uppercase">Total Revenue</span>
            <div class="fs-4 fw-bold text-success">LKR @Model.Metrics.TotalRevenueLKR.ToString("N2")</div>
            <div class="small text-muted">@Model.Metrics.SuccessfulPayments successful orders</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm">
            <span class="text-muted small text-uppercase">Total Orders</span>
            <div class="fs-4 fw-bold">@Model.Metrics.TotalTransactions</div>
            <div class="small text-muted">All payment attempts</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm">
            <span class="text-muted small text-uppercase">Active Subscriptions</span>
            <div class="fs-4 fw-bold text-primary">@Model.Metrics.ActiveSubscriptions</div>
            <div class="small text-muted">Currently active members</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card dashboard-card p-3 border-0 shadow-sm">
            <span class="text-muted small text-uppercase">Pending / Failed</span>
            <div class="fs-4 fw-bold text-warning">@Model.Metrics.PendingPayments / @Model.Metrics.FailedPayments</div>
            <div class="small text-muted">Pending IPN or cancelled</div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="card dashboard-card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Order ID, client, email..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="Paid" selected="@(Model.SelectedStatus == "Paid")">Paid</option>
                    <option value="Pending" selected="@(Model.SelectedStatus == "Pending")">Pending</option>
                    <option value="Failed" selected="@(Model.SelectedStatus == "Failed")">Failed</option>
                    <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="from" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="to" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-success flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Transactions Table -->
@if (Model.Transactions.Count == 0)
{
    <div class="alert alert-info">No transactions match your search criteria.</div>
}
else
{
    <div class="card dashboard-card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Order Reference</th>
                        <th scope="col">Client</th>
                        <th scope="col">Package Snapshot</th>
                        <th scope="col">Amount (LKR)</th>
                        <th scope="col">Status</th>
                        <th scope="col">Date (UTC)</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.Transactions)
                    {
                        <tr>
                            <td><code>@tx.OrderId @if (tx.IsDemo) { <span class="badge bg-warning text-dark">Demo Payment – No Real Money</span> }</code></td>
                            <td>
                                <strong>@tx.Client.FullName</strong>
                                <div class="small text-muted">@tx.Client.Email</div>
                            </td>
                            <td>
                                <div>@tx.PackageNameSnapshot</div>
                                <div class="small text-muted">@tx.DurationDaysSnapshot Days</div>
                            </td>
                            <td><strong class="text-success">LKR @tx.AmountLKR.ToString("N2")</strong></td>
                            <td>
                                @switch (tx.Status)
                                {
                                    case HealthTrack.Models.Payments.PaymentStatus.Paid:
                                        <span class="badge bg-success">Paid</span>
                                        break;
                                    case HealthTrack.Models.Payments.PaymentStatus.Pending:
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case HealthTrack.Models.Payments.PaymentStatus.Failed:
                                        <span class="badge bg-danger">Failed</span>
                                        break;
                                    case HealthTrack.Models.Payments.PaymentStatus.Cancelled:
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@tx.Status</span>
                                        break;
                                }
                            </td>
                            <td>@tx.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@tx.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                @if (tx.Status == HealthTrack.Models.Payments.PaymentStatus.Paid)
                                {
                                    <a asp-controller="Payments" asp-action="Receipt" asp-route-orderId="@tx.OrderId" class="btn btn-sm btn-outline-success">Receipt</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
