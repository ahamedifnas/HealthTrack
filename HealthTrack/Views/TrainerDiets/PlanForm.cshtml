@model DietPlanForm
<h1>@ViewData["Title"]</h1>
@if (Model.Clients.Count == 0)
{
    <div class="alert alert-info">You have no active assigned clients. Ask your Admin to assign a client using Trainer-Client Assignment on the Admin Dashboard.</div>
}
else
{
    <div class="card dashboard-card"><div class="card-body">
        <form asp-action="@ViewContext.RouteData.Values["action"]" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <partial name="_PlanFields" model="Model" />
            <div class="col-12 col-md-6 mb-3">
    <label asp-for="DailyCalories" class="form-label"></label>
    <input asp-for="DailyCalories" class="form-control" min="1" max="20000">
    <span asp-validation-for="DailyCalories" class="text-danger"></span>
</div>
            <button class="btn btn-primary" type="submit">Save plan</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div></div>
}
