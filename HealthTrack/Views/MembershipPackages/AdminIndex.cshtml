@model List<HealthTrack.Models.Memberships.MembershipPackage>
@{
    ViewData["Title"] = "Membership Packages";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Membership Packages</h1>
        <p class="text-muted mb-0">Manage membership tiers, LKR pricing, and package benefits.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">+ Create New Package</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No membership packages configured yet. Click "+ Create New Package" to get started.</div>
}
else
{
    <div class="card dashboard-card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Package Name</th>
                        <th scope="col">Price (LKR)</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created Date</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pkg in Model)
                    {
                        <tr>
                            <td>
                                <strong>@pkg.Name</strong>
                                <div class="small text-muted text-truncate" style="max-width: 350px;">@pkg.Description</div>
                            </td>
                            <td><strong class="text-success">LKR @pkg.PriceLKR.ToString("N2")</strong></td>
                            <td>@pkg.DurationDays days</td>
                            <td>
                                @if (pkg.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@pkg.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="ToggleStatus" asp-route-id="@pkg.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(pkg.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(pkg.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
