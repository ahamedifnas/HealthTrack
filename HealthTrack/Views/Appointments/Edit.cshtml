@model EditAppointmentForm
@{ ViewData["Title"] = "Update Appointment"; }
<section class="dashboard-heading"><h1>Update Appointment</h1><p class="mb-0">Reschedule or add notes. The current approval status is preserved.</p></section>
<div class="card dashboard-card"><div class="card-body">
    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
        <input asp-for="RowVersion" type="hidden" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        <partial name="_AppointmentScheduleFields" model="Model" />
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="4" maxlength="2000" aria-describedby="notes-help"></textarea>
            <div id="notes-help" class="form-text">Notes are visible to the Client and Admin.</div>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div></div>
