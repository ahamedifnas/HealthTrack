@model BookAppointmentForm
@inject HealthTrack.Services.Memberships.IMembershipSubscriptionService MembershipService
@{
    var editing = ViewData["IsEditing"] is true;
    ViewData["Title"] = editing ? "Edit Appointment Request" : "Book Appointment";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var activeSub = !string.IsNullOrEmpty(userId) ? await MembershipService.GetActiveSubscriptionAsync(userId) : null;
}

<section class="dashboard-heading mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h2 mb-1">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Select your preferred trainer and choose an available time slot generated from their weekly schedule.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Appointments
        </a>
    </div>
</section>

@if (activeSub != null)
{
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 shadow-sm border-0" role="status">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">✓</span>
            <div>
                <strong>Active Membership: @activeSub.PackageNameSnapshot</strong>
                <span class="text-muted small d-block">You have full member privileges to book appointments through @activeSub.EndDate.ToString("dd MMMM yyyy").</span>
            </div>
        </div>
        <a asp-controller="Payments" asp-action="Membership" class="btn btn-sm btn-outline-success">My Membership</a>
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-center justify-content-between p-3 mb-4 shadow-sm border-0" role="status">
        <div class="d-flex align-items-center gap-2">
            <span class="fs-4">ℹ️</span>
            <div>
                <strong>Notice: Standard Access</strong>
                <span class="text-muted small d-block">You do not have an active membership subscription. Subscribe to a package for priority scheduling and customized workout plans.</span>
            </div>
        </div>
        <a asp-controller="MembershipPackages" asp-action="Index" class="btn btn-sm btn-primary">Browse Packages</a>
    </div>
}

@if (Model.Trainers.Count == 0 && Model.HealthcareProfessionals.Count == 0)
{
    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle me-2"></i> No active trainers or healthcare professionals are currently available for booking.
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to appointments</a>
}
else
{
    <div class="card dashboard-card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="@(editing ? "EditRequest" : "Book")" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" id="bookingForm">
                @if (editing)
                {
                    <input asp-for="RowVersion" type="hidden" />
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger shadow-sm mb-4" role="alert"></div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="TrainerId" class="form-label fw-bold">Fitness Trainer</label>
                        <select asp-for="TrainerId" asp-items="Model.Trainers" class="form-select" id="trainerSelect">
                            <option value="">-- Choose a Trainer --</option>
                        </select>
                        <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        <div class="form-text">Selecting a trainer loads their real-time weekly availability and slots.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="HealthcareProfessionalId" class="form-label fw-bold">Healthcare Professional (Alternative)</label>
                        <select asp-for="HealthcareProfessionalId" asp-items="Model.HealthcareProfessionals" class="form-select" id="hcpSelect">
                            <option value="">-- Or choose a Healthcare Professional --</option>
                        </select>
                        <span asp-validation-for="HealthcareProfessionalId" class="text-danger small"></span>
                        <div class="form-text">Leave trainer unselected if booking with healthcare specialist.</div>
                    </div>
                </div>

                <div class="card bg-light border-0 mb-4 p-3">
                    <h5 class="card-title h6 fw-bold mb-3"><i class="bi bi-calendar-event me-2 text-success"></i>Date & Time Selection</h5>
                    <p class="text-muted small mb-3">All times use Asia/Colombo timezone (@ViewData["TimeZoneId"]). Past dates and times cannot be booked.</p>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold">Appointment Date</label>
                            <input asp-for="AppointmentDate" class="form-control" type="date" id="appointmentDateInput" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6" id="manualTimeGroup">
                            <label asp-for="AppointmentTime" class="form-label fw-semibold">Appointment Time</label>
                            <input asp-for="AppointmentTime" asp-format="{0:HH:mm}" class="form-control" type="time" step="60" id="appointmentTimeInput" />
                            <span asp-validation-for="AppointmentTime" class="text-danger small"></span>
                            <div class="form-text" id="timeHelpText">Click an available slot below or enter time directly.</div>
                        </div>
                    </div>

                    <!-- Dynamic Time Slots Container -->
                    <div id="slotsContainer" class="mt-3 p-3 bg-white rounded border" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history me-1 text-success"></i> Available Time Slots</h6>
                            <span id="slotsLoadingSpinner" class="spinner-border spinner-border-sm text-success" role="status" style="display: none;"></span>
                        </div>
                        <div id="slotsStatusMessage" class="small text-muted mb-2"></div>
                        <div id="slotsGrid" class="d-flex flex-wrap gap-2"></div>
                    </div>

                    <div id="selectedSlotSummary" class="mt-3 alert alert-success py-2 px-3 small" style="display: none;">
                        <i class="bi bi-check-circle-fill me-1"></i> <span id="selectedSlotText">No slot selected</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-bold">Reason for Appointment / Fitness Goals</label>
                    <textarea asp-for="Reason" class="form-control" rows="3" maxlength="1000" placeholder="Describe the consultation topic, fitness targets, or questions for your trainer..."></textarea>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-calendar-check me-1"></i> @(editing ? "Save Changes" : "Confirm Booking")
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const trainerSelect = document.getElementById("trainerSelect");
    const hcpSelect = document.getElementById("hcpSelect");
    const dateInput = document.getElementById("appointmentDateInput");
    const timeInput = document.getElementById("appointmentTimeInput");
    const slotsContainer = document.getElementById("slotsContainer");
    const slotsGrid = document.getElementById("slotsGrid");
    const slotsStatusMessage = document.getElementById("slotsStatusMessage");
    const slotsSpinner = document.getElementById("slotsLoadingSpinner");
    const selectedSummary = document.getElementById("selectedSlotSummary");
    const selectedText = document.getElementById("selectedSlotText");

    // Mutual exclusivity between Trainer and HCP selects
    if (trainerSelect && hcpSelect) {
        trainerSelect.addEventListener("change", function () {
            if (this.value) {
                hcpSelect.value = "";
            }
            fetchSlots();
        });
        hcpSelect.addEventListener("change", function () {
            if (this.value) {
                trainerSelect.value = "";
                slotsContainer.style.display = "none";
                selectedSummary.style.display = "none";
            }
        });
    }

    if (dateInput) {
        dateInput.addEventListener("change", fetchSlots);
    }

    function fetchSlots() {
        const trainerId = trainerSelect ? trainerSelect.value : "";
        const date = dateInput ? dateInput.value : "";

        if (!trainerId || !date) {
            slotsContainer.style.display = "none";
            selectedSummary.style.display = "none";
            return;
        }

        slotsContainer.style.display = "block";
        slotsGrid.innerHTML = "";
        slotsStatusMessage.textContent = "Checking trainer schedule...";
        slotsSpinner.style.display = "inline-block";

        fetch(`/Appointments/GetAvailableSlots?providerId=${encodeURIComponent(trainerId)}&date=${encodeURIComponent(date)}`)
            .then(response => response.json())
            .then(data => {
                slotsSpinner.style.display = "none";
                if (!data.success) {
                    slotsStatusMessage.innerHTML = `<span class="text-danger">${data.message || 'Error fetching slots'}</span>`;
                    return;
                }

                if (!data.slots || data.slots.length === 0) {
                    slotsStatusMessage.innerHTML = `<span class="text-muted"><i class="bi bi-calendar-x me-1"></i> Trainer has no scheduled working hours or is on leave for this date.</span>`;
                    return;
                }

                const availableCount = data.slots.filter(s => s.isAvailable).length;
                slotsStatusMessage.innerHTML = `<span class="text-success fw-semibold">${availableCount}</span> of ${data.slots.length} time slot(s) available on this date:`;

                data.slots.forEach(slot => {
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = slot.isAvailable 
                        ? "btn btn-sm btn-outline-success slot-chip" 
                        : "btn btn-sm btn-outline-secondary slot-chip disabled text-muted";
                    
                    const timeVal = slot.startTime.length > 5 ? slot.startTime.substring(0, 5) : slot.startTime;
                    
                    if (slot.isAvailable) {
                        btn.innerHTML = `<i class="bi bi-clock me-1"></i> ${slot.formattedRange || slot.formattedTime}`;
                        btn.addEventListener("click", function () {
                            // Deselect others
                            document.querySelectorAll(".slot-chip").forEach(b => {
                                b.classList.remove("btn-success", "text-white");
                                b.classList.add("btn-outline-success");
                            });
                            // Select this
                            btn.classList.remove("btn-outline-success");
                            btn.classList.add("btn-success", "text-white");
                            timeInput.value = timeVal;
                            selectedSummary.style.display = "block";
                            selectedText.textContent = `Selected Slot: ${slot.formattedRange || slot.formattedTime} on ${date}`;
                        });
                    } else {
                        btn.innerHTML = `<span class="text-decoration-line-through">${slot.formattedTime}</span> <span class="badge bg-secondary ms-1">${slot.reason || 'Unavailable'}</span>`;
                        btn.disabled = true;
                    }

                    // Auto-highlight if matching existing timeInput
                    if (timeInput.value && timeInput.value === timeVal && slot.isAvailable) {
                        btn.classList.remove("btn-outline-success");
                        btn.classList.add("btn-success", "text-white");
                        selectedSummary.style.display = "block";
                        selectedText.textContent = `Selected Slot: ${slot.formattedRange || slot.formattedTime} on ${date}`;
                    }

                    slotsGrid.appendChild(btn);
                });
            })
            .catch(err => {
                slotsSpinner.style.display = "none";
                slotsStatusMessage.innerHTML = `<span class="text-danger">Failed to load time slots. Please try again.</span>`;
            });
    }

    // Trigger initial check if values already filled (e.g. edit mode)
    if (trainerSelect && trainerSelect.value && dateInput && dateInput.value) {
        fetchSlots();
    }
});
</script>
}
