@model List<HealthTrack.Models.Admin.AdminUserListItem>
@{ var showRoles = ViewData["ShowRoles"] is true; }
@if (Model.Count == 0)
{
    <div class="alert alert-info">No accounts found.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th scope="col">Full name</th><th scope="col">Email</th><th scope="col">Status</th><th scope="col">Created date (UTC)</th>@if (showRoles) { <th scope="col">Roles</th> }</tr></thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td><td>@user.Email</td>
                    <td><span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    @if (showRoles) { <td>@(user.Roles.Count == 0 ? "No role assigned" : string.Join(", ", user.Roles))</td> }
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
