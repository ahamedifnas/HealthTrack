@model PlanViewModel

<h2 class="h4">Exercises</h2>
@if (Model.Exercises.Count == 0)
{
    <div class="alert alert-info">No exercises have been added yet.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Exercise</th><th>Sets</th><th>Repetitions</th><th>Minutes</th><th>Target kcal</th><th>Instructions</th>@if (Model.CanManage) { <th>Actions</th> }</tr></thead>
        <tbody>
        @foreach (var exercise in Model.Exercises)
        {
            <tr>
                <td>@exercise.ExerciseName</td><td>@exercise.Sets</td><td>@exercise.Repetitions</td>
                <td>@exercise.DurationMinutes</td><td>@exercise.CaloriesTarget</td><td class="text-break">@exercise.Instructions</td>
                @if (Model.CanManage)
                {
                    <td>
                        <a asp-controller="TrainerWorkouts" asp-action="ExerciseDetails" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-success">Details</a>
                        <a asp-controller="TrainerWorkouts" asp-action="EditExercise" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="TrainerWorkouts" asp-action="DeleteExercise" asp-route-id="@exercise.Id" class="btn btn-sm btn-outline-danger">Archive</a>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table></div></div>
}
