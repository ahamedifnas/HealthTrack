@model IReadOnlyList<HealthTrack.Models.Dashboard.DashboardAppointment>
@if (Model.Count == 0)
{
    <p class="empty-state">No appointments to display.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <caption class="visually-hidden">Appointment overview. Times shown in @ViewData["TimeZoneId"].</caption>
            <thead><tr><th scope="col">Client</th><th scope="col">Provider</th><th scope="col">Date &amp; time</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
            <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.ClientName</td><td>@appointment.TrainerName</td>
                    <td class="text-nowrap">@appointment.Date.ToString("dd MMM yyyy")<span class="table-detail">@appointment.Time.ToString("HH:mm")</span></td>
                    <td><span class="badge @appointment.StatusCss">@appointment.StatusLabel</span></td>
                    <td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" class="btn btn-sm btn-outline-success" aria-label="View appointment for @appointment.ClientName on @appointment.Date">View</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
