@model PlanViewModel

<h2 class="h4">Meal items</h2>
@if (Model.MealGroups.Count == 0)
{
    <div class="alert alert-info">No meal items have been added yet.</div>
}
@foreach (var group in Model.MealGroups)
{
    <section class="card dashboard-card mb-3">
        <div class="card-header"><h3 class="h5 mb-0">@group.Type</h3></div>
        <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th>Food</th><th>Quantity</th><th>kcal</th><th>Protein (g)</th><th>Carbs (g)</th><th>Fat (g)</th><th>Instructions</th>@if (Model.CanManage) { <th>Actions</th> }</tr></thead>
            <tbody>
            @foreach (var meal in group.Meals)
            {
                <tr>
                    <td>@meal.FoodName</td><td>@meal.Quantity</td><td>@meal.Calories</td>
                    <td>@meal.Protein</td><td>@meal.Carbohydrates</td><td>@meal.Fat</td><td class="text-break">@meal.Instructions</td>
                    @if (Model.CanManage)
                    {
                        <td>
                            <a asp-controller="TrainerDiets" asp-action="MealDetails" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-success">Details</a>
                            <a asp-controller="TrainerDiets" asp-action="EditMeal" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-controller="TrainerDiets" asp-action="DeleteMeal" asp-route-id="@meal.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table></div>
    </section>
}
