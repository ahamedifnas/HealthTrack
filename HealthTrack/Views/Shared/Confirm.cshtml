@model HealthTrack.Models.ConfirmationViewModel
@{ ViewData["Title"] = Model.Title; }
<section class="dashboard-heading"><h1>@Model.Title</h1><p class="mb-0">Review this action before continuing.</p></section>
<div class="card dashboard-card"><div class="card-body">
<p>@Model.Message</p>
<form asp-action="@Model.Action" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Confirm</button>
    <a asp-controller="@Model.BackController" asp-action="@Model.BackAction" asp-route-id="@Model.BackId" class="btn btn-outline-secondary">Go back</a>
</form>
</div></div>
