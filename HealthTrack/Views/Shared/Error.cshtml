@model ErrorViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Request could not be completed - HealthTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main class="container py-5">
        <h1>We couldn't complete your request.</h1>
        <p>Please try again. If the problem continues, contact support with the request ID below.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a href="@(Context.Request.PathBase + "/")" class="btn btn-success">Back to Home</a>
    </main>
</body>
</html>
