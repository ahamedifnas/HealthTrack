@model List<HealthTrack.Models.HealthMeasurement>
@{ ViewData["Title"] = "Health Measurements"; }
@if (true) { <p><a asp-controller="ReportDownloads" asp-action="Client" asp-route-kind="Measurements" asp-route-download="true" class="btn btn-success" download>Download PDF</a> <a asp-controller="ReportDownloads" asp-action="Client" asp-route-kind="Measurements" class="btn btn-outline-success">Filter report</a></p> }
<section class="dashboard-heading"><h1>Health Measurements</h1><p class="mb-0">Your personal measurement history.</p></section>
<div class="d-flex gap-2 flex-wrap mb-4"><a asp-action="Create" class="btn btn-success">+ Add Measurement</a><a asp-action="TargetWeight" class="btn btn-outline-success">Set target weight</a><a asp-controller="Progress" asp-action="Index" class="btn btn-outline-success">View progress</a></div>
@if (Model.Count == 0) { <div class="alert alert-info">No measurements yet. Add your first measurement to start tracking progress.</div> }
else { <partial name="_MeasurementHistory" model="Model" /> }
