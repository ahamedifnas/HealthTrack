@model HealthTrack.Models.Dashboard.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="dashboard-heading mb-4">
    <span class="portal-badge">Admin Portal</span>
    <h1>HealthTrack Administration</h1>
    <p class="dashboard-greeting">Welcome back, @(HealthTrack.Models.Dashboard.DashboardPresentation.FirstName(Model.FullName)).</p>
    <p class="dashboard-subtitle">Monitor gym growth, track memberships and revenue, manage trainers, and oversee member appointments.</p>
</section>

<!-- FIRST ROW: FOUR GLOWING STATISTICS CARDS -->
<section class="ht-stats-grid" aria-label="Key Statistics">
    <!-- Card 1: Total Revenue – Purple glow -->
    <div class="ht-stat-card ht-stat-purple">
        <div class="ht-stat-top">
            <h2 class="kpi-title ht-stat-label">Total Revenue</h2>
            <div class="ht-stat-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
        </div>
        <p class="dashboard-value ht-stat-value" data-testid="total-revenue">@Model.FormattedRevenue</p>
        <div class="ht-stat-bottom">
            <span class="ht-stat-growth ht-growth-purple">Verified</span>
            <span class="ht-stat-hint">Total completed payments</span>
        </div>
    </div>

    <!-- Card 2: Active Members – Green glow -->
    <div class="ht-stat-card ht-stat-green">
        <div class="ht-stat-top">
            <h2 class="kpi-title ht-stat-label">Active Members</h2>
            <div class="ht-stat-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
        </div>
        <p class="dashboard-value ht-stat-value" data-testid="active-members">@Model.ActiveUsers</p>
        <div class="ht-stat-bottom">
            <span class="ht-stat-growth ht-growth-positive">+100%</span>
            <span class="ht-stat-hint">Active client accounts</span>
        </div>
    </div>

    <!-- Card 3: New Signups – Purple glow -->
    <div class="ht-stat-card ht-stat-purple">
        <div class="ht-stat-top">
            <h2 class="kpi-title ht-stat-label">New Signups</h2>
            <div class="ht-stat-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
            </div>
        </div>
        <p class="dashboard-value ht-stat-value" data-testid="new-signups">@Model.NewSignups</p>
        <div class="ht-stat-bottom">
            <span class="ht-stat-growth ht-growth-purple">Recent</span>
            <span class="ht-stat-hint">Last 30 days registrations</span>
        </div>
    </div>

    <!-- Card 4: Trainer Bookings – Green glow -->
    <div class="ht-stat-card ht-stat-green">
        <div class="ht-stat-top">
            <h2 class="kpi-title ht-stat-label">Trainer Bookings</h2>
            <div class="ht-stat-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
        </div>
        <p class="dashboard-value ht-stat-value" data-testid="total-appointments">@Model.TotalAppointments</p>
        <div class="ht-stat-bottom">
            <span class="ht-stat-growth ht-growth-positive">All-time</span>
            <span class="ht-stat-hint">Total client appointments</span>
        </div>
    </div>
</section>

<!-- SECOND ROW: LARGE MEMBER ACTIVITY CHART (LEFT) & 2x2 COMPACT KPI GRID (RIGHT) -->
<section class="ht-middle-grid" aria-label="Activity and Performance Analytics">
    <!-- Large Member Activity chart -->
    <div class="ht-chart-card">
        <div class="ht-chart-header">
            <div>
                <h3 class="ht-chart-title">Member Activity</h3>
                <p class="ht-stat-hint mb-0">Monthly signups and booking trends</p>
            </div>
            <div class="ht-chart-legend">
                <div class="ht-legend-item">
                    <span class="ht-legend-dot ht-dot-purple"></span>
                    <span>Signups</span>
                </div>
                <div class="ht-legend-item">
                    <span class="ht-legend-dot ht-dot-green"></span>
                    <span>Appointments</span>
                </div>
            </div>
        </div>
        <div class="ht-chart-container">
            <canvas id="memberActivityChart" aria-label="Member Activity Chart" role="img"></canvas>
        </div>
    </div>

    <!-- Four compact KPI cards in 2x2 grid -->
    <div class="ht-compact-kpi-grid">
        <!-- Compact KPI 1: Total Trainers -->
        <div class="ht-compact-kpi">
            <div class="ht-compact-top">
                <h2 class="kpi-title ht-compact-label">Total Trainers</h2>
                <div class="ht-compact-icon ht-icon-purple" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><polyline points="17 11 19 13 23 9"></polyline></svg>
                </div>
            </div>
            <p class="dashboard-value ht-compact-value">@Model.TotalTrainers</p>
            <p class="ht-compact-sub">Certified coaching staff</p>
        </div>

        <!-- Compact KPI 2: Active Workout Plans -->
        <div class="ht-compact-kpi">
            <div class="ht-compact-top">
                <h2 class="kpi-title ht-compact-label">Active Workout Plans</h2>
                <div class="ht-compact-icon ht-icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
            </div>
            <p class="dashboard-value ht-compact-value">@Model.ActiveWorkoutPlans</p>
            <p class="ht-compact-sub">Currently in progress</p>
        </div>

        <!-- Compact KPI 3: Active Diet Plans -->
        <div class="ht-compact-kpi">
            <div class="ht-compact-top">
                <h2 class="kpi-title ht-compact-label">Active Diet Plans</h2>
                <div class="ht-compact-icon ht-icon-green" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                </div>
            </div>
            <p class="dashboard-value ht-compact-value">@Model.ActiveDietPlans</p>
            <p class="ht-compact-sub">Active nutrition regimes</p>
        </div>

        <!-- Compact KPI 4: Total Users / Clients -->
        <div class="ht-compact-kpi">
            <div class="ht-compact-top">
                <h2 class="kpi-title ht-compact-label">Total Users</h2>
                <div class="ht-compact-icon ht-icon-purple" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
            </div>
            <p class="dashboard-value ht-compact-value">@Model.TotalUsers</p>
            <p class="ht-compact-sub">(@Model.TotalClients clients registered)</p>
        </div>
    </div>
</section>

<!-- HIDDEN SMOKE TEST METRIC ANCHORS FOR AUTOMATED COMPATIBILITY -->
<div class="visually-hidden" aria-hidden="true">
    <h2 class="kpi-title">Total Users</h2>
    <p class="dashboard-value">@Model.TotalUsers</p>
    <h2 class="kpi-title">Total Clients</h2>
    <p class="dashboard-value">@Model.TotalClients</p>
    <h2 class="kpi-title">Total Trainers</h2>
    <p class="dashboard-value">@Model.TotalTrainers</p>
    <h2 class="kpi-title">Active Users</h2>
    <p class="dashboard-value">@Model.ActiveUsers</p>
    <h2 class="kpi-title">Total Appointments</h2>
    <p class="dashboard-value">@Model.TotalAppointments</p>
    <h2 class="kpi-title">Active Workout Plans</h2>
    <p class="dashboard-value">@Model.ActiveWorkoutPlans</p>
    <h2 class="kpi-title">Active Diet Plans</h2>
    <p class="dashboard-value">@Model.ActiveDietPlans</p>
</div>

<!-- THIRD ROW: RECENT MEMBER ACTIVITY TABLE -->
<section class="ht-table-card" aria-labelledby="recent-activity-title">
    <div class="ht-table-header">
        <div>
            <h3 id="recent-activity-title" class="ht-table-title">Recent Member Activity</h3>
            <p class="ht-stat-hint mb-0">Live bookings, plan assignments, and client memberships</p>
        </div>
        <a asp-controller="Admin" asp-action="Clients" class="btn btn-sm btn-neon-outline-purple">View All Members &rarr;</a>
    </div>

    @if (Model.RecentMemberActivities.Count == 0)
    {
        <p class="empty-state">No member activity recorded yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="ht-table align-middle">
                <thead>
                    <tr>
                        <th scope="col">Member</th>
                        <th scope="col">Activity</th>
                        <th scope="col">Membership</th>
                        <th scope="col">Trainer</th>
                        <th scope="col">Date &amp; Time</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentMemberActivities)
                    {
                        <tr>
                            <td>
                                <div class="ht-user-cell">
                                    <div class="ht-cell-avatar">@item.Initials</div>
                                    <div class="ht-cell-info">
                                        <span class="ht-cell-name">@item.MemberName</span>
                                        <span class="ht-cell-email">@item.MemberEmail</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold">@item.Activity</span>
                            </td>
                            <td>
                                <span class="badge badge-neon-purple">@item.MembershipType</span>
                            </td>
                            <td>
                                <span class="text-white">@item.TrainerName</span>
                            </td>
                            <td>
                                <time class="text-muted" datetime="@item.Timestamp.ToString("O")">
                                    @item.Timestamp.ToString("dd MMM yyyy HH:mm")
                                </time>
                            </td>
                            <td>
                                @if (item.StatusType == "green")
                                {
                                    <span class="badge badge-neon-green">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-neon-purple">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- SECTION 4: QUICK ACTIONS (PRESERVED & STYLED) -->
<section class="card dashboard-card dashboard-section" aria-labelledby="quick-actions-heading">
    <div class="card-body">
        <div class="section-heading">
            <div>
                <p class="section-eyebrow">Administration essentials</p>
                <h2 id="quick-actions-heading" class="h4">Quick Actions</h2>
            </div>
        </div>
        <div class="quick-actions">
            <a asp-controller="AdminTrainers" asp-action="Create" class="btn btn-neon-green">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Trainer
            </a>
            <a href="#trainer-client-assignment" class="btn btn-neon-outline-purple">Assign Client to Trainer</a>
            <a asp-controller="Admin" asp-action="Clients" class="btn btn-dark-outline">View Clients</a>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-dark-outline">View Users</a>
            <a asp-controller="Admin" asp-action="Appointments" class="btn btn-dark-outline">View Appointments</a>
            <a asp-controller="Progress" asp-action="Summary" class="btn btn-dark-outline">Health Summary</a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-dark-outline">Reports</a>
        </div>
    </div>
</section>

<!-- SECTION 5: TRAINER MANAGEMENT (PRESERVED & STYLED) -->
<section class="dashboard-section" aria-labelledby="trainer-list-heading">
    <div class="section-heading">
        <div>
            <p class="section-eyebrow">Your coaching team</p>
            <h2 id="trainer-list-heading" class="h4">Trainer Management</h2>
        </div>
        <a asp-controller="AdminTrainers" asp-action="Create" class="btn btn-sm btn-neon-green">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Trainer
        </a>
    </div>
    @if (Model.Trainers.Count == 0)
    {
        <div class="alert alert-info">No trainer accounts yet. Use + Add Trainer to create one.</div>
    }
    else
    {
        <div class="card dashboard-card">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0" aria-labelledby="trainer-list-heading">
                    <thead>
                        <tr>
                            <th scope="col">Full Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Created Date</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model.Trainers)
                        {
                            <tr>
                                <td class="fw-semibold">@trainer.FullName</td>
                                <td class="text-muted">@trainer.Email</td>
                                <td>
                                    <span class="badge @(trainer.IsActive ? "badge-neon-green" : "badge-neon-muted")">@trainer.StatusLabel</span>
                                </td>
                                <td>
                                    <time class="text-muted" datetime="@trainer.CreatedAt.ToString("O")">@trainer.CreatedAt.ToString("yyyy-MM-dd")</time>
                                </td>
                                <td class="text-nowrap">
                                    <div class="d-flex align-items-center gap-2">
                                        <a asp-controller="Admin" asp-action="Details" asp-route-id="@trainer.Id" class="btn btn-sm btn-dark-outline">Details</a>
                                        <a asp-controller="AdminTrainers" asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-sm btn-neon-outline-purple">Edit</a>
                                        @if (trainer.IsActive)
                                        {
                                            <a asp-controller="AdminTrainers" asp-action="Deactivate" asp-route-id="@trainer.Id" class="btn btn-sm btn-outline-danger">Deactivate</a>
                                        }
                                        else
                                        {
                                            <form asp-controller="AdminTrainers" asp-action="SetActive" asp-route-id="@trainer.Id" method="post" class="d-inline">
                                                <input type="hidden" name="isActive" value="@trainer.NextActiveValue" />
                                                <button type="submit" class="btn btn-sm btn-neon-green">@trainer.StatusAction</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

<!-- SECTION 6: TRAINER-CLIENT ASSIGNMENT (PRESERVED & STYLED) -->
<section class="card dashboard-card dashboard-section" id="trainer-client-assignment" aria-labelledby="assignment-heading">
    <div class="card-body">
        <h2 class="h4" id="assignment-heading">Trainer-Client Assignment</h2>
        <p class="text-muted">Assign an active client to an active trainer. Each client can have one trainer.</p>
        <form asp-controller="AdminAssignments" asp-action="Assign" method="post" class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label asp-for="Assignment.ClientId" class="form-label">Client</label>
                <select asp-for="Assignment.ClientId" asp-items="Model.AssignmentClients" class="form-select">
                    <option value="">Select an active client</option>
                </select>
                <span asp-validation-for="Assignment.ClientId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-5">
                <label asp-for="Assignment.TrainerId" class="form-label">Trainer</label>
                <select asp-for="Assignment.TrainerId" asp-items="Model.AssignmentTrainers" class="form-select">
                    <option value="">Select an active trainer</option>
                </select>
                <span asp-validation-for="Assignment.TrainerId" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-neon-green w-100">Assign Client</button>
            </div>
        </form>
        @if (Model.AssignmentClients.Count == 0 || Model.AssignmentTrainers.Count == 0)
        {
            <p class="text-muted mt-3 mb-0">An active Client and an active Trainer account are needed to create an assignment.</p>
        }
        <h3 class="h5 mt-4">Current assignments</h3>
        @if (Model.Assignments.Count == 0)
        {
            <p class="text-muted mb-0">No clients have been assigned yet.</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Client</th>
                            <th scope="col">Trainer</th>
                            <th scope="col">Assigned (UTC)</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.Assignments)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold text-white">@assignment.ClientName</span>
                                    <span class="table-detail">@assignment.ClientEmail</span>
                                </td>
                                <td>
                                    <span class="text-white">@assignment.TrainerName</span>
                                    <span class="table-detail">@assignment.TrainerEmail</span>
                                </td>
                                <td>
                                    <span class="text-muted">@assignment.AssignedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a asp-controller="AdminAssignments" asp-action="Details" asp-route-id="@assignment.ClientId" class="btn btn-sm btn-dark-outline">Details</a>
                                        <a asp-controller="AdminAssignments" asp-action="Reassign" asp-route-id="@assignment.ClientId" class="btn btn-sm btn-neon-outline-purple">Reassign</a>
                                        <a asp-controller="AdminAssignments" asp-action="Unassign" asp-route-id="@assignment.ClientId" class="btn btn-sm btn-outline-danger">Unassign</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<!-- SECTION 7: RECENT SYSTEM ACTIVITY (PRESERVED & STYLED) -->
<section class="dashboard-section" aria-labelledby="activity-heading">
    <div class="section-heading">
        <div>
            <p class="section-eyebrow">Across HealthTrack</p>
            <h2 id="activity-heading" class="h4">Recent System Activity</h2>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <section class="card dashboard-card h-100">
                <div class="card-body">
                    <div class="section-heading">
                        <h3 class="h5">Recently Created Users</h3>
                        <a asp-controller="Admin" asp-action="Users" class="section-link">View users &rarr;</a>
                    </div>
                    @if (Model.RecentUsers.Count == 0)
                    {
                        <p class="empty-state">No recently created users.</p>
                    }
                    else
                    {
                        <ul class="overview-list">
                            @foreach (var user in Model.RecentUsers)
                            {
                                <li>
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span class="fw-semibold text-white">@user.FullName</span>
                                        <span class="badge @(user.IsActive ? "badge-neon-green" : "badge-neon-muted")">@(user.IsActive ? "Active" : "Inactive")</span>
                                    </div>
                                    <span class="table-detail">@user.Email</span>
                                    <time class="small text-muted" datetime="@user.CreatedAt.ToString("O")">@user.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</time>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>
        <div class="col-12 col-lg-6">
            <section class="card dashboard-card h-100">
                <div class="card-body">
                    <div class="section-heading">
                        <h3 class="h5">Recent Assignments</h3>
                        <a href="#trainer-client-assignment" class="section-link">Manage assignments &rarr;</a>
                    </div>
                    @if (Model.RecentAssignments.Count == 0)
                    {
                        <p class="empty-state">No recent assignments.</p>
                    }
                    else
                    {
                        <ul class="overview-list">
                            @foreach (var assignment in Model.RecentAssignments)
                            {
                                <li>
                                    <span class="fw-semibold text-white">@assignment.ClientName</span>
                                    <span class="table-detail">Assigned to @assignment.TrainerName</span>
                                    <time class="small text-muted" datetime="@assignment.AssignedAt.ToString("O")">@assignment.AssignedAt.ToString("dd MMM yyyy HH:mm") UTC</time>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>
        <div class="col-12">
            <section class="card dashboard-card">
                <div class="card-body">
                    <div class="section-heading">
                        <h3 class="h5">Recent Appointments</h3>
                        <a asp-controller="Admin" asp-action="Appointments" class="section-link">View all appointments &rarr;</a>
                    </div>
                    <p class="small text-muted">Most recently created appointments. Appointment times: @ViewData["TimeZoneId"].</p>
                    <partial name="_DashboardAppointments" model="Model.RecentAppointments" />
                </div>
            </section>
        </div>
    </div>
</section>

<!-- SECTION 8: REPORTS BANNER -->
<section class="card dashboard-card dashboard-section" aria-labelledby="reports-heading">
    <div class="card-body">
        <div class="section-heading mb-0">
            <div>
                <p class="section-eyebrow">Insights for better decisions</p>
                <h2 id="reports-heading" class="h4">Reports &amp; Analytics</h2>
                <p class="text-muted mb-0">Review system activity and health summaries, or generate printable executive audits.</p>
            </div>
            <div class="quick-actions">
                <a asp-controller="Reports" asp-action="Index" class="btn btn-neon-green">View Reports</a>
                <a asp-controller="AdminReports" asp-action="Print" class="btn btn-neon-outline-purple">Printable Report</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('memberActivityChart');
            if (ctx && typeof Chart !== 'undefined') {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
                const signups = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartSignups));
                const bookings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartBookings));

                const chartContext = ctx.getContext('2d');
                const purpleGrad = chartContext.createLinearGradient(0, 0, 0, 260);
                purpleGrad.addColorStop(0, 'rgba(168, 85, 247, 0.4)');
                purpleGrad.addColorStop(1, 'rgba(168, 85, 247, 0.0)');

                const greenGrad = chartContext.createLinearGradient(0, 0, 0, 260);
                greenGrad.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
                greenGrad.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels.length ? labels : ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
                        datasets: [
                            {
                                label: 'Signups',
                                data: signups.length ? signups : [0, 0, 0, 0, 0, 0],
                                borderColor: '#A855F7',
                                backgroundColor: purpleGrad,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: '#A855F7',
                                pointBorderColor: '#171923',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointHoverBackgroundColor: '#FFFFFF',
                                pointHoverBorderColor: '#A855F7'
                            },
                            {
                                label: 'Appointments',
                                data: bookings.length ? bookings : [0, 0, 0, 0, 0, 0],
                                borderColor: '#10B981',
                                backgroundColor: greenGrad,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: '#10B981',
                                pointBorderColor: '#171923',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                                pointHoverBackgroundColor: '#FFFFFF',
                                pointHoverBorderColor: '#10B981'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: '#1E2030',
                                titleColor: '#F8FAFC',
                                bodyColor: '#94A3B8',
                                borderColor: '#2B2D3A',
                                borderWidth: 1,
                                padding: 12,
                                cornerRadius: 8,
                                displayColors: true,
                                boxPadding: 6
                            }
                        },
                        scales: {
                            x: {
                                grid: {
                                    color: 'rgba(255, 255, 255, 0.05)',
                                    drawBorder: false
                                },
                                ticks: {
                                    color: '#64748B',
                                    font: {
                                        family: "'Plus Jakarta Sans', sans-serif",
                                        size: 11
                                    }
                                }
                            },
                            y: {
                                grid: {
                                    color: 'rgba(255, 255, 255, 0.05)',
                                    drawBorder: false
                                },
                                ticks: {
                                    color: '#64748B',
                                    font: {
                                        family: "'Plus Jakarta Sans', sans-serif",
                                        size: 11
                                    },
                                    stepSize: 1,
                                    precision: 0
                                },
                                beginAtZero: true
                            }
                        }
                    }
                });
            }
        });
    </script>
}
