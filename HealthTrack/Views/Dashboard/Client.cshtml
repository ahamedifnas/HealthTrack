@model HealthTrack.Models.Dashboard.ClientDashboardViewModel
@{
    ViewData["Title"] = "Client Dashboard";
}
<section class="dashboard-heading">
    <p class="dashboard-eyebrow">Your health, one day at a time</p>
    <h1>Welcome, @Model.FullName!</h1>
    <p class="mb-0">Your Client dashboard brings your daily health essentials together.</p>
</section>
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-controller="Workouts" asp-action="Index" class="btn btn-primary">My Workouts</a>
    <a asp-controller="Diets" asp-action="Index" class="btn btn-outline-primary">My Diet</a>
</div>
<p class="text-muted">Your workout and diet plans are available above. Summary cards below remain previews.</p>
<div class="row g-4">
    @foreach (var title in new[] { "Current Weight", "BMI", "Calories Burned", "Target Weight" })
    {
        <div class="col-12 col-sm-6 col-xl-3">
            <section class="card dashboard-card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">@title</h2>
                    <p class="dashboard-value">—</p>
                    <p class="small text-muted mb-0">Not available yet</p>
                </div>
            </section>
        </div>
    }
    @foreach (var title in new[] { "Today's Workout", "Today's Diet", "Upcoming Appointment", "Recent Progress" })
    {
        <div class="col-12 col-lg-6">
            <section class="card dashboard-card h-100">
                <div class="card-body">
                    <span class="badge dashboard-badge mb-3">Coming soon</span>
                    <h2 class="h5">@title</h2>
                    <p class="text-muted mb-0">Your @title.ToLowerInvariant() details will appear here when this feature is available.</p>
                </div>
            </section>
        </div>
    }
</div>
