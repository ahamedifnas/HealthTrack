@{
    ViewData["Title"] = "Trainer Dashboard";
}
<section class="dashboard-heading">
    <p class="dashboard-eyebrow">Support healthier habits</p>
    <h1>Trainer Dashboard</h1>
    <p class="mb-0">A place to keep track of your clients and their plans.</p>
</section>
<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-controller="Clients" asp-action="Index" class="btn btn-primary">Assigned Clients</a>
    <a asp-controller="TrainerWorkouts" asp-action="Index" class="btn btn-outline-primary">Workout Plans</a>
    <a asp-controller="TrainerDiets" asp-action="Index" class="btn btn-outline-primary">Diet Plans</a>
</div>
<p class="text-muted">The summary cards below are previews; use the links above to manage client plans.</p>
<div class="row g-4">
    @foreach (var title in new[] { "Total Clients", "Today's Appointments", "Pending Appointments", "Active Workout Plans", "Active Diet Plans" })
    {
        <div class="col-12 col-sm-6 col-xl-4">
            <section class="card dashboard-card h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">@title</h2>
                    <p class="dashboard-value">—</p>
                    <p class="small text-muted mb-0">Not available yet</p>
                </div>
            </section>
        </div>
    }
    <div class="col-12 col-sm-6 col-xl-4">
        <section class="card dashboard-card h-100">
            <div class="card-body">
                <span class="badge dashboard-badge mb-3">Coming soon</span>
                <h2 class="h5">Recent Clients</h2>
                <p class="text-muted mb-0">Your recently assigned clients will appear here.</p>
            </div>
        </section>
    </div>
</div>
