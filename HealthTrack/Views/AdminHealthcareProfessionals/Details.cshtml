@model HealthcareProfessional
@{ ViewData["Title"] = "Healthcare Professional Details"; }
<h1>@ViewData["Title"]</h1>
<div class="card dashboard-card"><div class="card-body"><dl class="row">
<dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.User.FullName</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.User.Email</dd>
<dt class="col-sm-3">Specialty</dt><dd class="col-sm-9">@Model.Specialty</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.User.IsActive ? "Active" : "Inactive")</dd>
</dl><div class="quick-actions"><a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-success">Edit</a>
@if (Model.User.IsActive) { <a asp-controller="Admin" asp-action="Delete" asp-route-id="@Model.UserId" class="btn btn-outline-danger">Deactivate</a> }
<a asp-action="Index" class="btn btn-outline-secondary">Back to List</a></div></div></div>
