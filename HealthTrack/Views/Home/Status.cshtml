@model int
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Request unavailable - HealthTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main class="container py-5">
        @if (Model == 404)
        {
            <h1>We couldn't find that page or record.</h1>
            <p>It may no longer be available, or you may not have access to it.</p>
        }
        else if (Model == 400)
        {
            <h1>We couldn't process that request.</h1>
            <p>Return to the form, reload it, and try again.</p>
        }
        else
        {
            <h1>This request is unavailable.</h1>
            <p>Please return home and try again.</p>
        }
        <a href="@(Context.Request.PathBase + "/")" class="btn btn-success">Back to Home</a>
    </main>
</body>
</html>
