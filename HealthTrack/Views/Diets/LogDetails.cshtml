@model MealLog
@{ ViewData["Title"] = "Meal Log Details"; }
<section class="dashboard-heading"><h1>Meal Log Details</h1><p class="mb-0">@Model.DietPlan.PlanName</p></section>
<div class="card dashboard-card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9 text-break">@Model.MealDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Meal type</dt><dd class="col-sm-9 text-break">@Model.MealType</dd>
        <dt class="col-sm-3">Food</dt><dd class="col-sm-9 text-break">@Model.FoodName</dd>
        <dt class="col-sm-3">Quantity</dt><dd class="col-sm-9 text-break">@Model.Quantity</dd>
        <dt class="col-sm-3">Calories</dt><dd class="col-sm-9 text-break">@Model.Calories kcal</dd>
        <dt class="col-sm-3">Notes</dt><dd class="col-sm-9 text-break">@(Model.Notes ?? "No notes recorded.")</dd>
    </dl>
    <div class="quick-actions"><a asp-action="EditLog" asp-route-id="@Model.Id" class="btn btn-success">Edit</a><a asp-action="DeleteLog" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a><a asp-action="History"  class="btn btn-outline-secondary">Back</a></div>
</div></div>
