@model MealLogForm
@{ ViewData["Title"] = "Log Meal"; }
<h1>@ViewData["Title"]</h1>
@if (Model.Plans.Count == 0)
{
    <div class="alert alert-info">You need an active diet plan before you can add a log.</div>
}
else
{
    <p class="text-muted">Record what you ate. The date must be within the plan dates and cannot be in the future.</p>
    <div class="card dashboard-card"><div class="card-body">
    <form asp-action="Log" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="row"><div class="col-12 col-md-6 mb-3">
    <label asp-for="DietPlanId" class="form-label"></label>
    <select asp-for="DietPlanId" class="form-select" asp-items="Model.Plans"></select>
    <span asp-validation-for="DietPlanId" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="MealDate" class="form-label"></label>
    <input asp-for="MealDate" class="form-control" >
    <span asp-validation-for="MealDate" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="MealType" class="form-label"></label>
    <select asp-for="MealType" class="form-select" asp-items="Html.GetEnumSelectList<MealType>()"></select>
    <span asp-validation-for="MealType" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="FoodName" class="form-label"></label>
    <input asp-for="FoodName" class="form-control" >
    <span asp-validation-for="FoodName" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="Quantity" class="form-label"></label>
    <input asp-for="Quantity" class="form-control" placeholder="e.g. 1 cup (150 g)">
    <span asp-validation-for="Quantity" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="Calories" class="form-label"></label>
    <input asp-for="Calories" class="form-control" >
    <span asp-validation-for="Calories" class="text-danger"></span>
</div>
<div class="col-12 col-md-6 mb-3">
    <label asp-for="Notes" class="form-label"></label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div></div>
        <button class="btn btn-primary" type="submit">Save meal</button>
        <a asp-action="History" class="btn btn-outline-secondary">View history</a>
    </form>
    </div></div>
}
