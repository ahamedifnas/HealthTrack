@model List<MealLog>
@{ ViewData["Title"] ??= "Meal History"; }
<h1>@ViewData["Title"]</h1>
@if (ViewData["CanLog"] is true)
{
    <a asp-controller="Diets" asp-action="Log" class="btn btn-primary mb-3">Log Meal</a>
}
@if (Model.Count == 0)
{
    <div class="alert alert-info">No logs yet.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Date</th><th>Plan</th><th>Meal type</th><th>Food</th><th>Quantity</th><th>kcal</th><th>Notes</th></tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr><td class="text-break">@log.MealDate.ToString("yyyy-MM-dd")</td><td class="text-break">@log.DietPlan.PlanName</td><td class="text-break">@log.MealType</td><td class="text-break">@log.FoodName</td><td class="text-break">@log.Quantity</td><td class="text-break">@log.Calories</td><td class="text-break">@log.Notes</td></tr>
        }
        </tbody>
    </table></div></div>
}
