@model List<MealLog>
@{ ViewData["Title"] ??= "Meal History"; }
@if (ViewData["CanLog"] is true) { <p><a asp-controller="ReportDownloads" asp-action="Client" asp-route-kind="Diet" asp-route-download="true" class="btn btn-success" download>Download PDF</a> <a asp-controller="ReportDownloads" asp-action="Client" asp-route-kind="Diet" class="btn btn-outline-success">Filter report</a></p> }
<h1>@ViewData["Title"]</h1>
@if (ViewData["CanLog"] is true)
{
    <a asp-controller="Diets" asp-action="Log" class="btn btn-primary mb-3">Log Meal</a>
}
@if (Model.Count == 0)
{
    <div class="alert alert-info">No logs yet.</div>
}
else
{
    <div class="card dashboard-card"><div class="table-responsive">
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Date</th><th>Plan</th><th>Meal type</th><th>Food</th><th>Quantity</th><th>kcal</th><th>Notes</th>@if (ViewData["CanLog"] is true) { <th scope="col">Actions</th> }</tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr><td class="text-break">@log.MealDate.ToString("yyyy-MM-dd")</td><td class="text-break">@log.DietPlan.PlanName</td><td class="text-break">@log.MealType</td><td class="text-break">@log.FoodName</td><td class="text-break">@log.Quantity</td><td class="text-break">@log.Calories</td><td class="text-break">@log.Notes</td>@if (ViewData["CanLog"] is true) { <td><div class="d-flex gap-2 flex-wrap"><a asp-controller="Diets" asp-action="LogDetails" asp-route-id="@log.Id" class="btn btn-sm btn-outline-success">Details</a><a asp-controller="Diets" asp-action="EditLog" asp-route-id="@log.Id" class="btn btn-sm btn-outline-success">Edit</a><a asp-controller="Diets" asp-action="DeleteLog" asp-route-id="@log.Id" class="btn btn-sm btn-outline-danger">Delete</a></div></td> }</tr>
        }
        </tbody>
    </table></div></div>
}

