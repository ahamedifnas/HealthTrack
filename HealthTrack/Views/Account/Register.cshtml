@model HealthTrack.Models.Account.RegisterViewModel
@{ ViewData["Title"] = "Create an account"; }
<h1>Create an account</h1><p class="auth-intro">Start tracking your health with a Client account.</p>
<form asp-action="Register" method="post" data-auth-form>
<div asp-validation-summary="All" class="auth-validation text-danger" role="alert" tabindex="-1"></div>
<div class="mb-3">
<label asp-for="FullName" class="form-label"></label>
<input asp-for="FullName" class="form-control" autocomplete="name" aria-describedby="FullName-error" autofocus />


<span asp-validation-for="FullName" id="FullName-error" class="text-danger"></span></div>
<div class="mb-3">
<label asp-for="Email" class="form-label"></label>
<input asp-for="Email" class="form-control" autocomplete="email" aria-describedby="Email-error"  />


<span asp-validation-for="Email" id="Email-error" class="text-danger"></span></div>
<div class="mb-3">
<label asp-for="Password" class="form-label"></label>
<div class="auth-password"><input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="Password-error password-help"  />
<button type="button" class="password-toggle" data-password="Password" aria-controls="Password" aria-label="Show password" aria-pressed="false" hidden>Show</button></div>
<div id="password-help" class="form-text">Use 8–100 characters, including uppercase, lowercase, a number and a symbol.</div>
<span asp-validation-for="Password" id="Password-error" class="text-danger"></span></div>
<div class="mb-3">
<label asp-for="ConfirmPassword" class="form-label"></label>
<div class="auth-password"><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="ConfirmPassword-error"  />
<button type="button" class="password-toggle" data-password="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Show password" aria-pressed="false" hidden>Show</button></div>

<span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary w-100">Register</button></form>
<p class="auth-secondary">Already have an account? <a asp-action="Login">Login</a></p>
