@model HealthTrack.Models.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot your password?"; }
<h1>Forgot your password?</h1><p class="auth-intro">Enter your email address and we'll send you a secure password reset link.</p>
<form asp-action="ForgotPassword" method="post" data-auth-form>
<div asp-validation-summary="All" class="auth-validation text-danger" role="alert" tabindex="-1"></div>
<div class="mb-3">
<label asp-for="Email" class="form-label"></label>
<input asp-for="Email" class="form-control" autocomplete="email" aria-describedby="Email-error" autofocus />


<span asp-validation-for="Email" id="Email-error" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary w-100">Send Reset Link</button></form>
<p class="auth-secondary"><a asp-action="Login">Back to Login</a></p>
