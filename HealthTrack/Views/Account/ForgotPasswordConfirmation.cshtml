@{ ViewData["Title"] = "Check your email"; }
<h1>Check your email</h1><p class="auth-intro">Your password reset request has been received.</p>
<p>If an account exists for that email address and delivery succeeds, you will receive password reset instructions.</p>
<p class="text-muted">Check your spam folder. If no email arrives, try again or contact the HealthTrack administrator to check email delivery.</p>
<a asp-action="Login" class="btn btn-primary w-100">Back to Login</a><p class="auth-secondary"><a asp-action="ForgotPassword">Try again</a></p>

