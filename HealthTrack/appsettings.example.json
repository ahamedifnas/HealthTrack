    "MerchantId": "YOUR_PAYHERE_MERCHANT_ID",
    "MerchantSecret": "YOUR_PAYHERE_MERCHANT_SECRET",
    "Mode": "REPLACE_WITH_PAYMENT_MODE",
    "CheckoutUrl": "https://REPLACE_WITH_PAYHERE_CHECKOUT_HOST/pay/checkout",
    "Currency": "REPLACE_WITH_CURRENCY"
  },
  "Payments": {
    "Provider": "REPLACE_WITH_PAYMENT_PROVIDER"
  },
  "EmailSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "EnableSsl": true,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "sender@example.com",
    "FromName": "HealthTrack",
    "PublicBaseUrl": "https://YOUR_PUBLIC_HOST"
