{
  "Appointments": {
    "TimeZoneId": "REPLACE_WITH_TIME_ZONE_ID"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;Trusted_Connection=True;TrustServerCertificate=True",
    "DemoConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DEMO_DATABASE;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "REPLACE_WITH_ALLOWED_HOSTS",
